USE master;
GO

IF DB_ID('IntrasevMotors') IS NOT NULL
    DROP DATABASE IntrasevMotors;
GO

CREATE DATABASE IntrasevMotors;
GO

USE IntrasevMotors;
GO


-- =====================================
-- ELIMINAR TABLAS SI EXISTEN
-- =====================================

IF OBJECT_ID('Detalle_Venta', 'U') IS NOT NULL
    DROP TABLE Detalle_Venta;
GO

IF OBJECT_ID('Venta', 'U') IS NOT NULL
    DROP TABLE Venta;
GO

IF OBJECT_ID('Producto', 'U') IS NOT NULL
    DROP TABLE Producto;
GO

IF OBJECT_ID('Empleado', 'U') IS NOT NULL
    DROP TABLE Empleado;
GO

IF OBJECT_ID('Cliente', 'U') IS NOT NULL
    DROP TABLE Cliente;
GO


-- =====================================
-- TABLA CLIENTE
-- =====================================

CREATE TABLE Cliente
(
    ID_Cliente INT PRIMARY KEY IDENTITY(1,1),
    Razon_Social_Nombre VARCHAR(150) NOT NULL,
    DNI_RUC VARCHAR(20) NOT NULL UNIQUE,
    Telefono VARCHAR(15) NULL,
    Correo VARCHAR(100) NULL,
    Direccion VARCHAR(200) NULL
);
GO


-- =====================================
-- TABLA EMPLEADO
-- =====================================

CREATE TABLE Empleado
(
    ID_Empleado INT PRIMARY KEY IDENTITY(1,1),
    Nombre_Completo VARCHAR(150) NOT NULL,
    Cargo VARCHAR(50) NOT NULL,
    Telefono VARCHAR(15) NULL
);
GO


-- =====================================
-- TABLA PRODUCTO
-- =====================================

CREATE TABLE Producto
(
    ID_Producto INT PRIMARY KEY IDENTITY(1,1),
    Nombre_Producto VARCHAR(150) NOT NULL,
    Categoria VARCHAR(50) NOT NULL,
    Marca_Compatible VARCHAR(50) NULL,
    Precio DECIMAL(10,2) NOT NULL,
    Stock INT NOT NULL
);
GO


-- =====================================
-- TABLA VENTA
-- =====================================

CREATE TABLE Venta
(
    ID_Venta INT PRIMARY KEY IDENTITY(1,1),
    Fecha_Venta DATETIME NOT NULL DEFAULT GETDATE(),
    Total DECIMAL(10,2) NOT NULL,
    ID_Cliente INT NOT NULL,
    ID_Empleado INT NOT NULL,

    CONSTRAINT FK_Cliente_Venta
    FOREIGN KEY (ID_Cliente)
    REFERENCES Cliente(ID_Cliente),

    CONSTRAINT FK_Empleado_Venta
    FOREIGN KEY (ID_Empleado)
    REFERENCES Empleado(ID_Empleado)
);
GO


-- =====================================
-- TABLA DETALLE_VENTA
-- =====================================

CREATE TABLE Detalle_Venta
(
    ID_Detalle INT PRIMARY KEY IDENTITY(1,1),
    ID_Venta INT NOT NULL,
    ID_Producto INT NOT NULL,
    Cantidad INT NOT NULL,
    Precio_Unitario DECIMAL(10,2) NOT NULL,
    Subtotal DECIMAL(10,2) NOT NULL,

    CONSTRAINT FK_Venta_DetalleVenta
    FOREIGN KEY (ID_Venta)
    REFERENCES Venta(ID_Venta),

    CONSTRAINT FK_Producto_DetalleVenta
    FOREIGN KEY (ID_Producto)
    REFERENCES Producto(ID_Producto)
);
GO


