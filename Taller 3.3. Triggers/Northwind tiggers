from products 
where productname = 'producto de prueba';
--4.trigger para mantener histórico de cambios de precio
-- creación de la tabla de histórico de precios
if object_id('dbo.historico_precios', 'u') is not null
    drop table dbo.historico_precios;
go

create table dbo.historico_precios (
    id_historico int identity(1,1) primary key,
    productid int,
    precio_anterior money,
    precio_nuevo money,
    fecha_cambio datetime default getdate()
);
go

-- trigger 
create trigger tr_historico_cambio_precio
on products
after update
as
begin
    set nocount on;
    if update(unitprice)
    begin
        insert into dbo.historico_precios (productid, precio_anterior, precio_nuevo)
        select i.productid, d.unitprice, i.unitprice
        from inserted i
        inner join deleted d on i.productid = d.productid
        where i.unitprice <> d.unitprice;
    end;
end;
go

-- modificamos el precio de un producto existente de la base de datos
update products
set unitprice = 25.00
where productid = 3;

-- comando para comprobar que el cambio quedó registrado en el historial
select * from dbo.historico_precios;

-- 5. Trigger de Descuento Automático por Volumen de Compra
create trigger tr_descuento_automatico_volumen
on "order details"
after insert
as
begin
    set nocount on;
    
    -- si la cantidad es de 50 o más unidades, actualiza el descuento al 15%
    update od
    set od.discount = 0.15
    from "order details" od
    inner join inserted i on od.orderid = i.orderid and od.productid = i.productid
    where i.quantity >= 50;
end;
go

