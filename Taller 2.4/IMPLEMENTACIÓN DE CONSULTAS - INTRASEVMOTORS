// --- CONSULTAS AVANZADAS (4) ---

// 7. Total de Ventas por Cliente (GroupBy + Sum)
private void btnVentasPorCliente_Click(object sender, EventArgs e)
{
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from v in db.Venta
                      group v by v.Cliente.Razon_Social_Nombre into grupo
                      select new {
                          Cliente = grupo.Key,
                          TotalInvertido = grupo.Sum(x => x.Total),
                          CantidadCompras = grupo.Count()
                      };
        dgvConsulta.DataSource = consulta.ToList();
    }
}

// 8. Productos más vendidos (Agrupación de Detalles > 3 tablas)
private void btnTopProductos_Click(object sender, EventArgs e)
{
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from d in db.Detalle_Venta
                      group d by d.Producto.Nombre_Producto into grupo
                      select new {
                          Producto = grupo.Key,
                          TotalVendido = grupo.Sum(x => x.Cantidad)
                      };
        dgvConsulta.DataSource = consulta.OrderByDescending(x => x.TotalVendido).ToList();
    }
}

// 9. Reporte de Ventas por Mes y Año (Cálculos estadísticos)
private void btnVentasMensuales_Click(object sender, EventArgs e)
{
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from v in db.Venta
                      group v by new { v.Fecha_Venta.Month, v.Fecha_Venta.Year } into grupo
                      select new {
                          Mes = grupo.Key.Month,
                          Anio = grupo.Key.Year,
                          IngresoMensual = grupo.Sum(x => x.Total)
                      };
        dgvConsulta.DataSource = consulta.ToList();
    }
}

// 10. Empleados con más ventas realizadas (Proyección anónima compleja)
private void btnRankingVendedores_Click(object sender, EventArgs e)
{
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from v in db.Venta
                      group v by v.Empleado.Nombre_Completo into grupo
                      select new {
                          Vendedor = grupo.Key,
                          VentasRealizadas = grupo.Count(),
                          MontoTotal = grupo.Sum(x => x.Total)
                      };
        dgvConsulta.DataSource = consulta.OrderByDescending(x => x.MontoTotal).ToList();
    }
}
