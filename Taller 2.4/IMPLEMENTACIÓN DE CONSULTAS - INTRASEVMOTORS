// --- CONSULTAS BÁSICAS (2) ---

// 1. Listar todos los Clientes (CRUD: Listar)
private void btnListarClientes_Click(object sender, EventArgs e)
{
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from c in db.Cliente
                      select c;
        dgvConsulta.DataSource = consulta.ToList();
    }
}

// 2. Buscar Producto por ID (CRUD: Buscar)
private void btnBuscarProducto_Click(object sender, EventArgs e)
{
    int idBusqueda = int.Parse(txtID.Text);
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from p in db.Producto
                      where p.ID_Producto == idBusqueda
                      select p;
        dgvConsulta.DataSource = consulta.ToList();
    }
}


// --- CONSULTAS INTERMEDIAS (4) ---

// 3. Listar Ventas con nombres de Clientes y Empleados (Navigation Properties)
private void btnVentasDetalladas_Click(object sender, EventArgs e)
{
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from v in db.Venta
                      select new {
                          v.ID_Venta,
                          v.Fecha_Venta,
                          Cliente = v.Cliente.Razon_Social_Nombre,
                          Vendedor = v.Empleado.Nombre_Completo,
                          v.Total
                      };
        dgvConsulta.DataSource = consulta.ToList();
    }
}

// 4. Filtrar Productos por Categoría y Stock mínimo
private void btnFiltroStock_Click(object sender, EventArgs e)
{
    string cat = cbocategoria.Text;
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from p in db.Producto
                      where p.Categoria == cat && p.Stock > 0
                      select p;
        dgvConsulta.DataSource = consulta.ToList();
    }
}

// 5. Listar Detalle de una Venta específica (Inner Join implícito)
private void btnDetalleVenta_Click(object sender, EventArgs e)
{
    int idVenta = int.Parse(txtVentaID.Text);
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
    {
        var consulta = from d in db.Detalle_Venta
                      where d.ID_Venta == idVenta
                      select new {
                          d.ID_Producto,
                          Producto = d.Producto.Nombre_Producto,
                          d.Cantidad,
                          d.Precio_Unitario,
                          d.Subtotal
                      };
        dgvConsulta.DataSource = consulta.ToList();
    }
}

// 6. Buscar Clientes por RUC o DNI
private void btnBuscarDNI_Click(object sender, EventArgs e)
{
    string doc = txtDNI.Text;
    using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
