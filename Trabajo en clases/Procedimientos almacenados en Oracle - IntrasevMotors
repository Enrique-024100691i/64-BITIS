CREATE TABLE Cliente
(
   ID_Cliente NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
   Razon_Social_Nombre VARCHAR2(150) NOT NULL,
   DNI_RUC VARCHAR2(20) NOT NULL UNIQUE,
   Telefono VARCHAR2(15),
   Correo VARCHAR2(100),
   Direccion VARCHAR2(200)
);
/

CREATE TABLE Empleado
(
   ID_Empleado NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
   Nombre_Completo VARCHAR2(150) NOT NULL,
   Cargo VARCHAR2(50) NOT NULL,
   Telefono VARCHAR2(15)
);
/

CREATE TABLE Producto
(
   ID_Producto NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
   Nombre_Producto VARCHAR2(150) NOT NULL,
   Categoria VARCHAR2(50) NOT NULL,
   Marca_Compatible VARCHAR2(50),
   Precio NUMBER(10,2) NOT NULL,
   Stock NUMBER NOT NULL
);
/

CREATE TABLE Venta
(
   ID_Venta NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
   Fecha_Venta DATE DEFAULT SYSDATE NOT NULL,
   Total NUMBER(10,2) NOT NULL,
   ID_Cliente NUMBER NOT NULL,
   ID_Empleado NUMBER NOT NULL,
   CONSTRAINT FK_Cliente_Venta FOREIGN KEY (ID_Cliente)
      REFERENCES Cliente(ID_Cliente),
   CONSTRAINT FK_Empleado_Venta FOREIGN KEY (ID_Empleado)
      REFERENCES Empleado(ID_Empleado)
);
/

CREATE TABLE Detalle_Venta
(
   ID_Detalle NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
   ID_Venta NUMBER NOT NULL,
   ID_Producto NUMBER NOT NULL,
   Cantidad NUMBER NOT NULL,
   Precio_Unitario NUMBER(10,2) NOT NULL,
   Subtotal NUMBER(10,2) NOT NULL,
   CONSTRAINT FK_Venta_DetalleVenta FOREIGN KEY (ID_Venta)
      REFERENCES Venta(ID_Venta),
   CONSTRAINT FK_Producto_DetalleVenta FOREIGN KEY (ID_Producto)
      REFERENCES Producto(ID_Producto)
);
/
