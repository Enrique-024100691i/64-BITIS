CREATE OR REPLACE PROCEDURE sp_registrar_cliente (
    p_nombre      IN Cliente.Razon_Social_Nombre%TYPE,
    p_dni_ruc     IN Cliente.DNI_RUC%TYPE,
    p_telefono    IN Cliente.Telefono%TYPE,
    p_correo      IN Cliente.Correo%TYPE,
    p_direccion   IN Cliente.Direccion%TYPE,
    p_mensaje     OUT VARCHAR2
)
AS
    v_existe NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO v_existe
    FROM Cliente
    WHERE DNI_RUC = p_dni_ruc;

    IF v_existe > 0 THEN
        p_mensaje := 'Error: el DNI/RUC ya existe';
    ELSE
        INSERT INTO Cliente (Razon_Social_Nombre, DNI_RUC, Telefono, Correo, Direccion)
        VALUES (p_nombre, p_dni_ruc, p_telefono, p_correo, p_direccion);

        p_mensaje := 'Cliente registrado correctamente';
    END IF;

    COMMIT;
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        p_mensaje := 'Error al registrar cliente: ' || SQLERRM;
END;
/
DECLARE
   v_mensaje VARCHAR2(200);
BEGIN
   sp_registrar_cliente(
      'Empresa Orion SAC',
      '20659874123',
      '999888777',
      'orion@gmail.com',
      'Av. Sol 123',
      v_mensaje
   );
   DBMS_OUTPUT.PUT_LINE(v_mensaje);
END;
/

CREATE OR REPLACE PROCEDURE sp_actualizar_stock (
    p_id_producto IN Producto.ID_Producto%TYPE,
    p_nuevo_stock IN Producto.Stock%TYPE,
    p_mensaje     OUT VARCHAR2
)
AS
    v_existe NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO v_existe
    FROM Producto
    WHERE ID_Producto = p_id_producto;

    IF v_existe = 0 THEN
        p_mensaje := 'Error: el producto no existe';
    ELSIF p_nuevo_stock < 0 THEN
        p_mensaje := 'Error: el stock no puede ser negativo';
    ELSE
        UPDATE Producto
        SET Stock = p_nuevo_stock
        WHERE ID_Producto = p_id_producto;

        p_mensaje := 'Stock actualizado correctamente';
    END IF;

    COMMIT;
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        p_mensaje := 'Error al actualizar stock: ' || SQLERRM;
END;
/
DECLARE
   v_mensaje VARCHAR2(200);
BEGIN
   sp_actualizar_stock(1, 10, v_mensaje);
   DBMS_OUTPUT.PUT_LINE(v_mensaje);
END;
/
CREATE OR REPLACE PROCEDURE sp_total_ventas_cliente (
    p_id_cliente   IN Cliente.ID_Cliente%TYPE,
    p_total_ventas OUT NUMBER,
    p_mensaje      OUT VARCHAR2
)
AS
    v_existe NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO v_existe
    FROM Cliente
    WHERE ID_Cliente = p_id_cliente;

    IF v_existe = 0 THEN
        p_total_ventas := 0;
        p_mensaje := 'Error: cliente no existe';
    ELSE
        SELECT NVL(SUM(Total),0)
        INTO p_total_ventas
        FROM Venta
        WHERE ID_Cliente = p_id_cliente;

        p_mensaje := 'Consulta realizada correctamente';
    END IF;
EXCEPTION
    WHEN OTHERS THEN
        p_total_ventas := 0;
        p_mensaje := 'Error al consultar ventas: ' || SQLERRM;
END;
/
DECLARE
   v_total NUMBER;
   v_mensaje VARCHAR2(200);
BEGIN
   sp_total_ventas_cliente(1, v_total, v_mensaje);
   DBMS_OUTPUT.PUT_LINE(v_mensaje);
   DBMS_OUTPUT.PUT_LINE('Total vendido: ' || v_total);
END;
/
CREATE OR REPLACE PROCEDURE sp_registrar_venta (
    p_fecha_venta     IN DATE,
    p_id_cliente      IN NUMBER,
    p_id_empleado     IN NUMBER,
    p_id_producto     IN NUMBER,
    p_cantidad        IN NUMBER,
    p_mensaje         OUT VARCHAR2
)
AS
    v_precio          NUMBER(10,2);
    v_stock           NUMBER;
    v_total           NUMBER(10,2);
    v_id_venta        NUMBER;
    v_existe_cliente  NUMBER;
    v_existe_empleado NUMBER;
    v_existe_producto NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_existe_cliente
    FROM Cliente
    WHERE ID_Cliente = p_id_cliente;

    SELECT COUNT(*) INTO v_existe_empleado
    FROM Empleado
    WHERE ID_Empleado = p_id_empleado;

    SELECT COUNT(*) INTO v_existe_producto
    FROM Producto
    WHERE ID_Producto = p_id_producto;

    IF v_existe_cliente = 0 THEN
        p_mensaje := 'Error: cliente no existe';
        RETURN;
    ELSIF v_existe_empleado = 0 THEN
        p_mensaje := 'Error: empleado no existe';
        RETURN;
    ELSIF v_existe_producto = 0 THEN
        p_mensaje := 'Error: producto no existe';
        RETURN;
    END IF;

    SELECT Precio, Stock
    INTO v_precio, v_stock
    FROM Producto
    WHERE ID_Producto = p_id_producto;

    IF p_cantidad <= 0 THEN
        p_mensaje := 'Error: cantidad inválida';
        RETURN;
    ELSIF v_stock < p_cantidad THEN
        p_mensaje := 'Error: stock insuficiente';
        RETURN;
    END IF;

    v_total := v_precio * p_cantidad;

    INSERT INTO Venta (Fecha_Venta, Total, ID_Cliente, ID_Empleado)
    VALUES (p_fecha_venta, v_total, p_id_cliente, p_id_empleado)
    RETURNING ID_Venta INTO v_id_venta;

    INSERT INTO Detalle_Venta (ID_Venta, ID_Producto, Cantidad, Precio_Unitario, Subtotal)
    VALUES (v_id_venta, p_id_producto, p_cantidad, v_precio, v_total);

    UPDATE Producto
    SET Stock = Stock - p_cantidad
    WHERE ID_Producto = p_id_producto;

    COMMIT;
    p_mensaje := 'Venta registrada correctamente con ID: ' || v_id_venta;
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        p_mensaje := 'Error al registrar venta: ' || SQLERRM;
END;
/
DECLARE
   v_mensaje VARCHAR2(200);
BEGIN
   sp_registrar_venta(
      SYSDATE,
      1,
      1,
      3,
      2,
      v_mensaje
   );
   DBMS_OUTPUT.PUT_LINE(v_mensaje);
END;
/
CREATE OR REPLACE PROCEDURE sp_productos_stock_bajo (
    p_limite IN NUMBER
)
AS
    CURSOR c_productos IS
        SELECT ID_Producto, Nombre_Producto, Stock
        FROM Producto
        WHERE Stock <= p_limite
        ORDER BY Stock ASC;
BEGIN
    DBMS_OUTPUT.PUT_LINE('PRODUCTOS CON STOCK BAJO');
    DBMS_OUTPUT.PUT_LINE('------------------------');

    FOR r IN c_productos LOOP
        DBMS_OUTPUT.PUT_LINE(
            'ID: ' || r.ID_Producto ||
            ' | Producto: ' || r.Nombre_Producto ||
            ' | Stock: ' || r.Stock
        );
    END LOOP;
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error al listar productos: ' || SQLERRM);
END;
/
BEGIN
   sp_productos_stock_bajo(5);
END;
