-- Borrar la base de datos si ya existe para evitar conflictos de "Base de datos en uso"
IF EXISTS (SELECT name FROM sys.databases WHERE name = 'EcommerceElectronicos')
BEGIN
    ALTER DATABASE EcommerceElectronicos SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE EcommerceElectronicos;
END
GO

-- 1. CREACIÓN DE LA BASE DE DATOS Y CONTEXTO
CREATE DATABASE EcommerceElectronicos;
GO

USE EcommerceElectronicos;
GO

-- 2. CREACIÓN DE TABLAS 


CREATE TABLE Categoria (
    idCat          INT IDENTITY(1,1) PRIMARY KEY,
    nombreCat      VARCHAR(100)      NOT NULL,
    descripcionCat VARCHAR(255)      NULL
);

CREATE TABLE Marca (
    idMarca         INT IDENTITY(1,1) PRIMARY KEY,
    nombreMarca     VARCHAR(100)      NOT NULL,
    paisOrigenMarca VARCHAR(100)      NOT NULL
);

CREATE TABLE Cliente (
    idC              INT IDENTITY(1,1) PRIMARY KEY,
    nombreCompletoC  VARCHAR(150)      NOT NULL,
    emailC           VARCHAR(150)      NOT NULL,
    contrasenaC      VARCHAR(255)      NOT NULL,
    CONSTRAINT UQ_Cliente_Email UNIQUE (emailC)
);
GO 
CREATE TABLE Producto (
    idP          INT           IDENTITY(1,1) PRIMARY KEY,
    nombreP      VARCHAR(150)                NOT NULL,
    descripcionP VARCHAR(500)                NULL,
    precioP      DECIMAL(10,2)               NOT NULL,
    stockP       INT                         NOT NULL,
    idCat        INT                         NOT NULL,
    idMarca      INT                         NOT NULL,
    CONSTRAINT FK_Producto_Categoria FOREIGN KEY (idCat) REFERENCES Categoria(idCat),
    CONSTRAINT FK_Producto_Marca     FOREIGN KEY (idMarca) REFERENCES Marca(idMarca),
    CONSTRAINT CK_Producto_Precio    CHECK (precioP >= 0),
    CONSTRAINT CK_Producto_Stock     CHECK (stockP  >= 0)
);

CREATE TABLE DireccionEnvio (
    idDir        INT IDENTITY(1,1) PRIMARY KEY,
    idC          INT               NOT NULL,
    calleDir     VARCHAR(200)      NOT NULL,
    ciudadDir    VARCHAR(100)      NOT NULL,
    paisDir      VARCHAR(100)      NOT NULL,
    codPostalDir VARCHAR(20)       NULL,
    CONSTRAINT FK_DireccionEnvio_Cliente FOREIGN KEY (idC) REFERENCES Cliente(idC)
);

CREATE TABLE Pedido (
    idPed     INT IDENTITY(1,1) PRIMARY KEY,
    fechaPed  DATE              NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    estadoPed VARCHAR(20)       NOT NULL,
    idC       INT               NOT NULL,
    CONSTRAINT FK_Pedido_Cliente FOREIGN KEY (idC) REFERENCES Cliente(idC),
    CONSTRAINT CK_Pedido_Estado  CHECK (estadoPed IN ('Pendiente', 'Enviado', 'Entregado'))
);
GO 

CREATE TABLE ItemPedido (
    idItem       INT IDENTITY(1,1) PRIMARY KEY,
    cantidadItem INT               NOT NULL,
    idPed        INT               NOT NULL,
    idP          INT               NOT NULL,
    CONSTRAINT FK_ItemPedido_Pedido   FOREIGN KEY (idPed) REFERENCES Pedido(idPed),
    CONSTRAINT FK_ItemPedido_Producto FOREIGN KEY (idP) REFERENCES Producto(idP),
    CONSTRAINT CK_ItemPedido_Cantidad CHECK (cantidadItem > 0)
);

CREATE TABLE Opinion (
    idOpin           INT           IDENTITY(1,1) PRIMARY KEY,
    calificacionOpin INT                         NOT NULL,
    comentarioOpin   VARCHAR(500)                NULL,
    fechaOpin        DATE                        NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    idC              INT                         NOT NULL,
    idP              INT                         NOT NULL,
    CONSTRAINT FK_Opinion_Cliente  FOREIGN KEY (idC) REFERENCES Cliente(idC),
    CONSTRAINT FK_Opinion_Producto FOREIGN KEY (idP) REFERENCES Producto(idP),
    CONSTRAINT CK_Opinion_Calif    CHECK (calificacionOpin BETWEEN 1 AND 5)
);
GO

