        private void button1_Click(object sender, EventArgs e)
        {
            using (IntrasevMotorsEntities db = new IntrasevMotorsEntities())
            {
                var consulta = from c in db.Cliente
                               select new
                               {
                                   c.ID_Cliente,
                                   c.Razon_Social_Nombre,
                                   c.DNI_RUC,
                                   c.Telefono,
                                   c.Correo,
                                   c.Direccion
                               };

                dgvTabla.DataSource = consulta.ToList();
            }
        }

