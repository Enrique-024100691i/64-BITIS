        private void button12_Click(object sender, EventArgs e)
        {
            {
                using (pubsEntities pubs = new pubsEntities())
                {
                    var consulta1 = from S in pubs.sales
                                    where S.qty > 20
                                    select S;

                    var consulta2 = from S in pubs.sales
                                    where S.payterms == "Net 30"
                                    select S;

                    var consulta = consulta1.Except(consulta2);

                    dgvPubs.DataSource = consulta
                        .Select(S => new
                        {
                            S.stor_id,
                            S.ord_num,
                            S.qty,
                            S.payterms
                        })
                        .ToList();
                }
            }
        }

