USE master;
GO

IF DB_ID('BDElectrodomesticosABC') IS NOT NULL
    DROP DATABASE BDElectrodomesticosABC;
GO

CREATE DATABASE BDElectrodomesticosABC;
GO

USE BDElectrodomesticosABC;
GO


-- =====================================
-- ELIMINAR TABLAS SI EXISTEN
-- =====================================

IF OBJECT_ID('DetalleMovimiento', 'U') IS NOT NULL
    DROP TABLE DetalleMovimiento;
GO

IF OBJECT_ID('Comprobante', 'U') IS NOT NULL
    DROP TABLE Comprobante;
GO

IF OBJECT_ID('OrdenCompra', 'U') IS NOT NULL
    DROP TABLE OrdenCompra;
GO

IF OBJECT_ID('Cliente', 'U') IS NOT NULL
    DROP TABLE Cliente;
GO

IF OBJECT_ID('Electrodomestico', 'U') IS NOT NULL
    DROP TABLE Electrodomestico;
GO

IF OBJECT_ID('Proveedor', 'U') IS NOT NULL
    DROP TABLE Proveedor;
GO


-- =====================================
-- TABLA PROVEEDOR
-- =====================================

CREATE TABLE Proveedor
(
    idProv INT PRIMARY KEY IDENTITY(1,1),
    rucProv CHAR(11) NOT NULL,
    razonSocialProv VARCHAR(120) NOT NULL,
    telefonoProv VARCHAR(20) NOT NULL,
    direccionProv VARCHAR(150) NOT NULL,
    correoProv VARCHAR(100) NOT NULL
);
GO


-- =====================================
-- TABLA ELECTRODOMESTICO
-- =====================================

CREATE TABLE Electrodomestico
(
    idE INT PRIMARY KEY IDENTITY(1,1),
    nombreE VARCHAR(100) NOT NULL,
    descripcionE VARCHAR(200) NOT NULL,
    marcaE VARCHAR(80) NOT NULL,
    precioCompraE DECIMAL(10,2) NOT NULL,
    precioVentaE DECIMAL(10,2) NOT NULL,
    idProv INT NOT NULL,

    CONSTRAINT FK_Proveedor_Electrodomestico
    FOREIGN KEY (idProv)
    REFERENCES Proveedor(idProv)
);
GO


-- =====================================
-- TABLA CLIENTE
-- =====================================

CREATE TABLE Cliente
(
    idC INT PRIMARY KEY IDENTITY(1,1),
    tipoDocC VARCHAR(20) NOT NULL,
    nroDocC VARCHAR(20) NOT NULL,
    nombresC VARCHAR(100) NOT NULL,
    apellidosC VARCHAR(100) NOT NULL,
    celularC CHAR(9) NOT NULL,
    direccionC VARCHAR(150) NOT NULL
);
GO


-- =====================================
-- TABLA ORDEN DE COMPRA
-- =====================================

CREATE TABLE OrdenCompra
(
    idOC INT PRIMARY KEY IDENTITY(1,1),
    fechaHoraOC DATETIME NOT NULL,
    totalOC DECIMAL(10,2) NOT NULL,
    idProv INT NOT NULL,

    CONSTRAINT FK_Proveedor_OrdenCompra
    FOREIGN KEY (idProv)
    REFERENCES Proveedor(idProv)
);
GO


-- =====================================
-- TABLA COMPROBANTE
-- =====================================

CREATE TABLE Comprobante
(
    idComp INT PRIMARY KEY IDENTITY(1,1),
    fechaHoraComp DATETIME NOT NULL,
    totalComp DECIMAL(10,2) NOT NULL,
    tipoComp VARCHAR(20) NOT NULL,
    numeroComp VARCHAR(20) NOT NULL,
    idC INT NOT NULL,

    CONSTRAINT FK_Cliente_Comprobante
    FOREIGN KEY (idC)
    REFERENCES Cliente(idC)
);
GO


-- =====================================
-- TABLA DETALLE MOVIMIENTO
-- cantidad positiva = entrada
-- cantidad negativa = salida
-- =====================================

CREATE TABLE DetalleMovimiento
(
    idDet INT PRIMARY KEY IDENTITY(1,1),
    cantidadDet INT NOT NULL,
    precioUnitarioDet DECIMAL(10,2) NOT NULL,
    subtotalDet DECIMAL(10,2) NOT NULL,
    tipoMovimientoDet VARCHAR(10) NOT NULL,
    idE INT NOT NULL,
    idOC INT NULL,
    idComp INT NULL,

    CONSTRAINT FK_Electrodomestico_DetalleMovimiento
    FOREIGN KEY (idE)
    REFERENCES Electrodomestico(idE),

    CONSTRAINT FK_OrdenCompra_DetalleMovimiento
    FOREIGN KEY (idOC)
    REFERENCES OrdenCompra(idOC),

    CONSTRAINT FK_Comprobante_DetalleMovimiento
    FOREIGN KEY (idComp)
    REFERENCES Comprobante(idComp)
);
GO


