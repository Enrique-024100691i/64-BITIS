-- actividad: dominio de joins - northwind
use northwind;
go

-- 1. pedidos y sus empleados (inner)
select o.orderid as id_pedido, e.firstname as nombre_empleado
from orders o inner join employees e 
on o.employeeid = e.employeeid;

-- 2. productos y proveedores (inner)
select p.productname as producto, s.companyname as proveedor
from products p inner join suppliers s 
on p.supplierid = s.supplierid;

-- 3. detalle de pedidos y productos (inner)
-- nota: los corchetes [ ] son obligatorios por el espacio en el nombre
select od.orderid as id_pedido, p.productname as producto
from [order details] od inner join products p 
on od.productid = p.productid;

-- 4. pedidos y transportistas (inner)
select o.orderid as id_pedido, s.companyname as transportista
from orders o inner join shippers s 
on o.shipvia = s.shipperid;

-- 5. clientes y sus pedidos (inner)
select c.companyname as cliente, o.orderid as id_pedido
from customers c inner join orders o 
on c.customerid = o.customerid;

-- 6. productos y categorías (inner)
select p.productname as producto, c.categoryname as categoria
from products p inner join categories c 
on p.categoryid = c.categoryid;

-- 7. territorios de empleados (inner)
select e.firstname as nombre, t.territorydescription as territorio
from employees e inner join employeeterritories et 
on e.employeeid = et.employeeid
inner join territories t 
on et.territoryid = t.territoryid;

-- 8. ciudades de origen de proveedores (inner)
select p.productname as producto, s.city as ciudad
from products p inner join suppliers s 
on p.supplierid = s.supplierid;

-- 9. productos sin ventas (left join)
-- ahora saldrá el 'producto de prueba gemini'
select p.productname as producto_sin_venta, od.orderid as id_pedido
from products p left join [order details] od 
on p.productid = od.productid
where od.orderid is null;

-- 10. clientes sin pedidos (right join)
-- ahora saldrá 'estudiante crack sa'
select o.orderid as id_pedido, c.companyname as cliente_sin_pedido
from orders o right join customers c 
on o.customerid = c.customerid
where o.orderid is null;
